      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>CapExPFR</Type>
      <Description>Free on board equipment cost estimation for PFR</Description>
      <NamePrefix>CapEx</NamePrefix>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>CEPCI</Name>
          <Description>Global Chemical Engineering Plant Cost Index</Description>
          <Type>Dimensionless</Type>
          <Group>Economics</Group>
          <Default>596.2</Default>
          <Favorite />
          <Global />
        </Parameter>
        <Parameter>
          <Name>CurrencyFactor</Name>
          <Description>Global factor to convert default CapEx calculations from USD to local currency units</Description>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <Favorite />
          <Global />
        </Parameter>
        <Parameter>
          <Name>MOC</Name>
          <Description>CapExVessel material of construction</Description>
          <Type>Enumeration</Type>
          <Group>Economics</Group>
          <Default>Carbon Steel</Default>
          <Required />
          <Favorite />
          <Values>
            <Value>Carbon Steel</Value>
            <Value>Low-alloy Steel</Value>
            <Value>Stainless Steel 304</Value>
            <Value>Stainless Steel 316</Value>
            <Value>Carpenter 20CB-3</Value>
            <Value>Nickel-200</Value>
            <Value>Monel-400</Value>
            <Value>Iconel-600</Value>
            <Value>Icoloy-825</Value>
            <Value>Titanium</Value>
            <Value>Other</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>Orientation</Name>
          <Description>CapExVessel orientation</Description>
          <Type>Enumeration</Type>
          <Default>Vertical</Default>
          <UplevelReference />
          <Values>
            <Value>Vertical</Value>
            <Value>Horizontal</Value>
            <Value>Sphere</Value>
            <Value>Horiz Boot</Value>
            <Value>Vert Boot</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>rohm</Name>
          <Type>Mass Density</Type>
          <Default>7860</Default>
        </Parameter>
        <Parameter>
          <Name>thk_t</Name>
          <Description>Thickness tubes</Description>
          <Type>Thickness</Type>
          <Group>Economics</Group>
          <Default>3</Default>
          <Favorite />
        </Parameter>
        <Parameter>
          <Name>K1</Name>
          <Type>Real</Type>
          <Default>0.319</Default>
        </Parameter>
        <Parameter>
          <Name>n1</Name>
          <Type>Real</Type>
          <Group>Economics</Group>
          <Default>2.142</Default>
        </Parameter>
        <Parameter>
          <Name>CA</Name>
          <Description>Corrosion allowance</Description>
          <Type>Length</Type>
          <Group>Economics</Group>
          <Default>0.00315</Default>
          <Favorite />
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>Pro</Name>
          <Expression>Mode = Process</Expression>
        </Condition>
        <Condition>
          <Name>Horiz</Name>
          <Expression>Pro and (Orientation = Horizontal or Orientation = "Horiz Boot")</Expression>
        </Condition>
        <Condition>
          <Name>Vert</Name>
          <Expression>Pro and (Orientation = Vertical or Orientation = "Vert Boot")</Expression>
        </Condition>
        <Condition>
          <Name>Sph</Name>
          <Expression>Pro and Orientation = Sphere</Expression>
        </Condition>
        <Condition>
          <Name>HasBoot</Name>
          <Expression>Pro and (Orientation = "Vert Boot" or Orientation = "Horiz Boot")</Expression>
        </Condition>
        <Condition>
          <Name>NoBoot</Name>
          <Expression>Pro and Orientation &lt;&gt; "Vert Boot" and Orientation &lt;&gt; "Horiz Boot"</Expression>
        </Condition>
        <Condition>
          <Name>MOC1</Name>
          <Expression>Pro and MOC = "Carbon Steel"</Expression>
        </Condition>
        <Condition>
          <Name>MOC2</Name>
          <Expression>Pro and MOC = "Low-Alloy Steel"</Expression>
        </Condition>
        <Condition>
          <Name>MOC3</Name>
          <Expression>Pro and MOC = "Stainless Steel 304"</Expression>
        </Condition>
        <Condition>
          <Name>MOC4</Name>
          <Expression>Pro and MOC = "Stainless Steel 316"</Expression>
        </Condition>
        <Condition>
          <Name>MOC5</Name>
          <Expression>Pro and MOC = "Carpenter 20CB-3"</Expression>
        </Condition>
        <Condition>
          <Name>MOC6</Name>
          <Expression>Pro and MOC = "Nickel-200"</Expression>
        </Condition>
        <Condition>
          <Name>MOC7</Name>
          <Expression>Pro and MOC = "Monel-400"</Expression>
        </Condition>
        <Condition>
          <Name>MOC8</Name>
          <Expression>Pro and MOC = "Iconel-600"</Expression>
        </Condition>
        <Condition>
          <Name>MOC9</Name>
          <Expression>Pro and MOC = "Icoloy-825"</Expression>
        </Condition>
        <Condition>
          <Name>MOC10</Name>
          <Expression>Pro and MOC = "Titanium"</Expression>
        </Condition>
        <Condition>
          <Name>MOC11</Name>
          <Expression>(Pro and MOC = "Other") or (not Pro)</Expression>
        </Condition>
        <Condition>
          <Name>MOC12</Name>
          <Expression>Pro and MOC &lt;&gt; "Other"</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn3</Name>
          <Condition>Pro</Condition>
          <Type>Variable</Type>
          <From>D</From>
          <To>PFR.D</To>
        </Connection>
        <Connection>
          <Name>Conn5</Name>
          <Type>Variable</Type>
          <From>FM</From>
          <To>PFR.FM</To>
        </Connection>
        <Connection>
          <Name>Conn1</Name>
          <Type>Variable</Type>
          <From>Mm</From>
          <To>PFR.Mm</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>D</Name>
          <Description>CapExVessel diameter of the cylinder</Description>
          <Condition>Pro</Condition>
          <Type>Diameter</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>CapExVessel length of the cylinder</Description>
          <Condition>Pro</Condition>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>P</Name>
          <Description>CapExVessel pressure</Description>
          <Condition>Sph</Condition>
          <Type>Pressure</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>V</Name>
          <Description>CapExVessel volume</Description>
          <Condition>Sph</Condition>
          <Type>Volume</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>FM</Name>
          <Description>CapExVessel material correction factor. Typical values: \n     1.0: Carbon Steel\n     1.2: Low-alloy Steel\n     1.7: Stainless Steel 304\n     2.1: Stainless Steel 304\n     3.2: Carpenter 20CB-3\n     5.4: Nickel-200\n     3.6: Monel-400\n     3.9: Iconel-600\n     3.7: Icoloy-825\n     7.7: Titanium</Description>
          <Condition>MOC12</Condition>
          <Type>Ratio</Type>
        </Variable>
        <Variable>
          <Name>FM</Name>
          <Description>CapExVessel material correction factor. Typical values: \n     1.0: Carbon Steel\n     1.2: Low-alloy Steel\n     1.7: Stainless Steel 304\n     2.1: Stainless Steel 304\n     3.2: Carpenter 20CB-3\n     5.4: Nickel-200\n     3.6: Monel-400\n     3.9: Iconel-600\n     3.7: Icoloy-825\n     7.7: Titanium</Description>
          <Condition>MOC11</Condition>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
        </Variable>
        <Variable>
          <Name>FCP</Name>
          <Description>CapExVessel known cost scale factor to adjust pricing to a known cost from another source</Description>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
        </Variable>
        <Variable>
          <Name>CP</Name>
          <Description>CapExVessel free on board purchase cost of vessel including platform and ladders</Description>
          <Type>Currency</Type>
          <Group>Economics</Group>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <TotalizedVariable />
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>MM</Name>
          <Type>Metal Mass</Type>
        </Variable>
        <Variable>
          <Name>thk_s</Name>
          <Type>Thickness</Type>
          <Favorite />
        </Variable>
        <Variable>
          <Name>Nt</Name>
          <Type>Dimensionless</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>Vwt</Name>
          <Type>Volume</Type>
        </Variable>
        <Variable>
          <Name>Vws</Name>
          <Type>Volume</Type>
        </Variable>
        <Variable>
          <Name>D_s</Name>
          <Type>Diameter</Type>
        </Variable>
        <Variable>
          <Name>p_s</Name>
          <Type>Pressure</Type>
          <Favorite />
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>UncertaintyVessel</Name>
          <Type>Real</Type>
          <Global />
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>CostP</Name>
          <Description>Free on board purchase cost of vessel</Description>
          <Condition>NoBoot</Condition>
          <Formula>CP = PFR.CB * (CEPCI / 567) * FCP*UncertaintyVessel</Formula>
        </Equation>
        <Equation>
          <Name>FM1</Name>
          <Condition>MOC1</Condition>
          <Formula>FM = 1</Formula>
        </Equation>
        <Equation>
          <Name>FM2</Name>
          <Condition>MOC2</Condition>
          <Formula>FM = 1.2</Formula>
        </Equation>
        <Equation>
          <Name>FM3</Name>
          <Condition>MOC3</Condition>
          <Formula>FM = 1.7</Formula>
        </Equation>
        <Equation>
          <Name>FM4</Name>
          <Condition>MOC4</Condition>
          <Formula>FM = 2.1 </Formula>
        </Equation>
        <Equation>
          <Name>FM5</Name>
          <Condition>MOC5</Condition>
          <Formula>FM = 3.2</Formula>
        </Equation>
        <Equation>
          <Name>FM6</Name>
          <Condition>MOC6</Condition>
          <Formula>FM = 5.4</Formula>
        </Equation>
        <Equation>
          <Name>FM7</Name>
          <Condition>MOC7</Condition>
          <Formula>FM = 3.6</Formula>
        </Equation>
        <Equation>
          <Name>FM8</Name>
          <Condition>MOC8</Condition>
          <Formula>FM = 3.9</Formula>
        </Equation>
        <Equation>
          <Name>FM9</Name>
          <Condition>MOC9</Condition>
          <Formula>FM = 3.7</Formula>
        </Equation>
        <Equation>
          <Name>FM10</Name>
          <Condition>MOC10</Condition>
          <Formula>FM = 7.7</Formula>
        </Equation>
        <Equation>
          <Name>Eqn1</Name>
          <Formula>Vwt = Nt * 3.1415/4 * ((D+thk_t/1000*2)^2 - D^2) * L</Formula>
        </Equation>
        <Equation>
          <Name>Eqn2</Name>
          <Formula>D_s = (D+thk_t/1000*2) * (Nt/K1)^(1/n1)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn3</Name>
          <Formula>thk_s = (p_s*0.01 * D_s / (2*800*0.9 - 2.4*p_s*0.01) + CA) *1000</Formula>
        </Equation>
        <Equation>
          <Name>Eqn4</Name>
          <Formula>Vws = 3.1415/4 * ((D_s+thk_s/1000*2)^2 - D_s^2) * L + 3.1415/6 * ((D_s+thk_s/1000*2)^3 - D_s^3)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn5</Name>
          <Formula>Mm = (Vwt + Vws) * rohm</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>PFR</Name>
          <Library Version="9.1.0">Economics</Library>
          <Type>HorizDrum</Type>
        </Model>
      </Models>
      <Groups>
        <Group>
          <Name>Economics</Name>
          <Description>Operating expense and capital cost estimation</Description>
        </Group>
      </Groups>
