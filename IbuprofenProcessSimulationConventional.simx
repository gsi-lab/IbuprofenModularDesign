          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPPumps</Name>
          <Description>Summary total free on board purchase price of centrifugal pumps (and optional electric motors)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPComps</Name>
          <Description>Summary total free on board purchase price of compressors (including drivers and shaft coupling)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPVessels</Name>
          <Description>Summary total free on board purchase price of vessels (including platform and ladders)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCPColumns</Name>
          <Description>Summary total free on board purchase price of columns (including internals, platform and ladders)</Description>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>LandCost</Name>
          <Description>Summary initial capital investment to purchase land</Description>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>AnnualLaborCost</Name>
          <Description>Summary annual cost of labor to operate and maintain the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>SalvageValue</Name>
          <Description>Summary Salvage value of the plant at the end of the project's life</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>NPV</Name>
          <Description>Summary Net Present Value of the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>ROI</Name>
          <Description>Summary Return on Investment for the project</Description>
          <Condition>EA</Condition>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>NetProfit</Name>
          <Description>Summary total profit from the project over the course of the project's life</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>AnnualProfit</Name>
          <Description>Summary annual profit from the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>COMd</Name>
          <Description>Summary estimated annual cost of manufacturing without depreciation</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Group>Economic Analysis</Group>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>CumulativeCashFlow</Name>
          <Description>Summary cumulative cash flow produced by the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>CashFlow</Name>
          <Description>Summary annual cash flow produced by the project</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Dk</Name>
          <Description>Summary scheduled loss of value to equipment by year due to depreciation</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>DiscountCumulativeCashFlow</Name>
          <Description>Summary cumulative cash flow produced by the project using discounted cash flow values</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
          <Favorite />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>DiscountRate</Name>
          <Description>Summary discount rate to convert cash flow of a given year to its equivalent present value</Description>
          <Condition>EA</Condition>
          <Type>Ratio</Type>
          <Dimension>ConstructionTime+ProjectLife</Dimension>
          <Group>Economic Analysis</Group>
        </Variable>
        <Variable>
          <Name>Ieff</Name>
          <Description>Summary effective interest rate after adjusting for inflation</Description>
          <Type>Fraction</Type>
          <Group>Economic Analysis</Group>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>DeprecPlanCheck</Name>
          <Description>Summary check to make sure the project life is greater than the defined years for depreciation</Description>
          <Condition>EA</Condition>
          <Type>Dimensionless</Type>
        </Variable>
        <Variable>
          <Name>DeprecValueCheck</Name>
          <Description>Summary check to ensure depreciation value does not exceed the total value of fixed capital investment</Description>
          <Condition>EA</Condition>
          <Type>Currency</Type>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>TotalCapInvestment</Name>
          <Description>Summary total capital investment (includes initial, fixed, and working capitals)</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <Favorite />
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>EOC</Name>
          <Description>Summary equivalent operating cost (combines total capital cost with annual operating cost)</Description>
          <Type>Currency / Time</Type>
          <Group>Summary</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>TotalProduct</Name>
          <Description>Summary cumulative amount of product produced over time t</Description>
          <Type>Mass</Type>
          <Group>Summary</Group>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>CumulativeDynCost</Name>
          <Description>Summary cumulative amount of costs accrued over time t</Description>
          <Type>Currency</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Favorite />
        </Variable>
        <Variable>
          <Name>CDC</Name>
          <Description>Summary cumulative dynamic cost</Description>
          <Type>Currency</Type>
        </Variable>
        <Variable>
          <Name>dCDCdt</Name>
          <Description>Summary cumulative dynamic cost time derivative</Description>
          <Type>Real</Type>
          <Default>0</Default>
        </Variable>
        <Variable>
          <Name>LCOP</Name>
          <Description>Summary levelized cost of the product (operating costs per unit product produced)</Description>
          <Type>Currency / Mass</Type>
          <Group>Summary</Group>
          <ProcessMode Lock="Always">true</ProcessMode>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">false</DynamicMode>
          <Favorite />
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>TotalCPReactors</Name>
          <Type>Currency</Type>
          <Group>Total Capital Costs</Group>
          <Favorite />
        </Variable>
        <Variable>
          <Name>NaturalGasCost</Name>
          <Type>Currency / Time</Type>
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>OPC1</Name>
          <Formula>TotalUtilityCost = NaturalGasCost + TotalLPSteamCost + TotalMPSteamCost + TotalHPSteamCost + TotalElectricityCost + TotalNaturalGasCost + TotalFuelOilCost + TotalRefrigerantCost + TotalCoolingWaterCost + TotalBFWCost + TotalPlantAirCost</Formula>
        </Equation>
        <Equation>
          <Name>OPC2</Name>
          <Formula>TotalRawMatlCost = totalize("RawMatlCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC3</Name>
          <Formula>TotalProductValue = totalize("ProductValue")</Formula>
        </Equation>
        <Equation>
          <Name>OPC4</Name>
          <Formula>TotalWasteCost = totalize("WasteCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC5</Name>
          <Formula>TotalOperatingCost = TotalUtilityCost + TotalRawMatlCost +TotalWasteCost + TotalCO2eEmissionCost</Formula>
        </Equation>
        <Equation>
          <Name>OPC6</Name>
          <Formula>TotalLPSteamCost = totalize("LPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC7</Name>
          <Formula>TotalMPSteamCost = totalize("MPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC8</Name>
          <Formula>TotalHPSteamCost = totalize("HPSteamCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC9</Name>
          <Formula>TotalElectricityCost = totalize("ElectricityCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC10</Name>
          <Formula>TotalNaturalGasCost = totalize("NaturalGasCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC11</Name>
          <Formula>TotalFuelOilCost = totalize("FuelOilCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC12</Name>
          <Formula>TotalRefrigerantCost = totalize("RefrigerantCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC13</Name>
          <Formula>TotalCoolingWaterCost = totalize("CoolingWaterCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC14</Name>
          <Formula>TotalBFWCost = totalize("BFWCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC15</Name>
          <Formula>TotalPlantAirCost = totalize("PlantAirCost")</Formula>
        </Equation>
        <Equation>
          <Name>OPC16</Name>
          <Formula>TotalCO2eEmissionCost = CO2eEmission * totalize("CO2e")</Formula>
        </Equation>
        <Equation>
          <Name>Cap1</Name>
          <Formula>TotalCPHXs = totalize("CapExHX.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap2</Name>
          <Formula>TotalCPPumps = totalize("CapExPump.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap3</Name>
          <Formula>TotalCPComps = totalize("CapExComp.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap4</Name>
          <Formula>TotalCPVessels = totalize("CapExVessel.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap5</Name>
          <Formula>TotalCPColumns = totalize("CapExCol.CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap6</Name>
          <Formula>TotalPurchaseCost = totalize("CP")</Formula>
        </Equation>
        <Equation>
          <Name>Cap7</Name>
          <Formula>FixedCapInvestment = 1.05 * Lang_TPI * TotalPurchaseCost</Formula>
        </Equation>
        <Equation>
          <Name>Cap8</Name>
          <Formula>FWCapInvestment = 1.05 * Lang_TCI * TotalPurchaseCost</Formula>
        </Equation>
        <Equation>
          <Name>EA1</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>CashFlow[i] * ConstructionTime = -FWCapInvestment</Formula>
          <Start>1</Start>
          <End>ConstructionTime</End>
        </Equation>
        <Equation>
          <Name>EA2</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>CumulativeCashFlow[1] = -LandCost + CashFlow[1] </Formula>
        </Equation>
        <Equation>
          <Name>EA3</Name>
          <Condition>NoConstructionRequired</Condition>
          <Formula>CumulativeCashFlow[1] = -(LandCost + FWCapInvestment) + CashFlow[1] </Formula>
        </Equation>
        <Equation>
          <Name>EA4</Name>
          <Condition>EA</Condition>
          <Formula>CumulativeCashFlow[i] = (CumulativeCashFlow[i-1] + CashFlow[i])</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA5</Name>
          <Condition>EA</Condition>
          <Formula>CashFlow[i] = AnnualProfit[i] + Dk[i - ConstructionTime]</Formula>
          <Start>ConstructionTime+1</Start>
          <End>ConstructionTime+ProjectLife-1</End>
        </Equation>
        <Equation>
          <Name>EA6</Name>
          <Condition>EA</Condition>
          <Formula>CashFlow[i] = AnnualProfit[i] + Dk[i - ConstructionTime] + COMd + SalvageValue</Formula>
          <Start>ConstructionTime+ProjectLife</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA7</Name>
          <Formula>(1 + AnnualInflationRate) * Ieff = (AnnualInterestRate - AnnualInflationRate)</Formula>
        </Equation>
        <Equation>
          <Name>EA8</Name>
          <Condition>EA</Condition>
          <Formula>DiscountRate[1] = (1 + Ieff)</Formula>
        </Equation>
        <Equation>
          <Name>EA9</Name>
          <Condition>EA</Condition>
          <Formula>DiscountRate[i] = DiscountRate[i-1] * (1 + Ieff)</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA10</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>DiscountCumulativeCashFlow[1] = -LandCost + CashFlow[1] / DiscountRate[1]</Formula>
        </Equation>
        <Equation>
          <Name>EA11</Name>
          <Condition>NoConstructionRequired</Condition>
          <Formula>DiscountCumulativeCashFlow[1] = -(LandCost + FWCapInvestment) + CashFlow[1] / DiscountRate[1]</Formula>
        </Equation>
        <Equation>
          <Name>EA12</Name>
          <Condition>EA</Condition>
          <Formula>DiscountCumulativeCashFlow[i] = DiscountCumulativeCashFlow[i-1] + CashFlow[i] / DiscountRate[i]</Formula>
          <Start>2</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA13</Name>
          <Condition>EA</Condition>
          <Formula>NPV = DiscountCumulativeCashFlow[i]</Formula>
          <Start>ConstructionTime+ProjectLife</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA14</Name>
          <Condition>EA</Condition>
          <Formula>COMd = 0.180 * FixedCapInvestment + 2.73 * AnnualLaborCost + 1.23 * TotalOperatingCost * 31536000</Formula>
        </Equation>
        <Equation>
          <Name>EA15</Name>
          <Condition>ConstructionRequired</Condition>
          <Formula>AnnualProfit[i] = 0</Formula>
          <Start>1</Start>
          <End>ConstructionTime</End>
        </Equation>
        <Equation>
          <Name>EA16</Name>
          <Condition>EA</Condition>
          <Formula>AnnualProfit[i] = (TotalProductValue * 31536000 - COMd - Dk[i - ConstructionTime]) * (1 - AnnualTaxRate)</Formula>
          <Start>ConstructionTime+1</Start>
          <End>ConstructionTime+ProjectLife</End>
        </Equation>
        <Equation>
          <Name>EA17</Name>
          <Condition>EA</Condition>
          <Formula>NetProfit = sum(AnnualProfit)</Formula>
        </Equation>
        <Equation>
          <Name>EA18</Name>
          <Condition>EA</Condition>
          <Formula>(ROI + 1) * max(FixedCapInvestment, 1e-8) = NetProfit</Formula>
        </Equation>
        <Equation>
          <Name>EA19</Name>
          <Condition>EA</Condition>
          <Formula>DeprecPlanCheck = ProjectLife - Deprec.DepreciationTime</Formula>
        </Equation>
        <Equation>
          <Name>EA20</Name>
          <Condition>EA</Condition>
          <Formula>DeprecValueCheck = sum(Dk) - FixedCapInvestment - 1e-3</Formula>
        </Equation>
        <Equation>
          <Name>EA21</Name>
          <Formula>TotalCapInvestment = FWCapInvestment + LandCost</Formula>
        </Equation>
        <Equation>
          <Name>EA22</Name>
          <Description>Equivalent operating cost (86400 is seconds in a day)</Description>
          <Formula>(EOC - TotalOperatingCost) * ((1 + Ieff) ^ ProjectLife - 1) * DaysPerYear * 86400 = TotalCapInvestment * Ieff * (1+Ieff) ^ ProjectLife</Formula>
        </Equation>
        <Equation>
          <Name>LC1</Name>
          <Formula>TotalProduct = totalize("TotalProduct")</Formula>
        </Equation>
        <Equation>
          <Name>LC2</Name>
          <Condition>Dyn</Condition>
          <Formula>der(CDC) = EOC</Formula>
        </Equation>
        <Equation>
          <Name>LC3</Name>
          <Condition>Dyn</Condition>
          <Formula>CumulativeDynCost = CDC</Formula>
        </Equation>
        <Equation>
          <Name>LC4</Name>
          <Condition>Dyn</Condition>
          <Formula>LCOP * max(TotalProduct, 1e-6) = CumulativeDynCost</Formula>
        </Equation>
        <Equation>
          <Name>Cap9</Name>
          <Formula>TotalCPReactors=totalize("CapExCSTR.CP")</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>Deprec</Name>
          <Condition>EA</Condition>
          <ModelTypeParameter>DepreciationType</ModelTypeParameter>
        </Model>
      </Models>
      <Groups>
        <Group>
          <Name>Summary</Name>
          <Description>Summary of overall economic estimates</Description>
          <IsExpandedByDefault>true</IsExpandedByDefault>
        </Group>
        <Group>
          <Name>Global Utility Prices</Name>
          <Description>View and edit global utility prices for operating cost estimations</Description>
        </Group>
        <Group>
          <Name>Total Utility Costs</Name>
          <Description>Contribution of each utility to total operating cost</Description>
        </Group>
        <Group>
          <Name>Total Capital Costs</Name>
          <Description>Contribution of each equipment type to total capital cost</Description>
        </Group>
        <Group>
          <Name>Economic Analysis</Name>
          <Description>Metrics for assessing economics</Description>
        </Group>
      </Groups>
      <Messages>
        <Message>
          <Name>ProjectLifetimeRequired</Name>
          <Expression>ProjectLife &lt; 1</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Lifetime of the project must be at least 1 year or greater. Increase the value of ProjectLife</DisplayMessage>
        </Message>
        <Message>
          <Name>DepreciationNeedsUpdated</Name>
          <Expression>DeprecPlanCheck &lt; 0</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Lifetime of the project is less than the planned years for depreciation. Replace the current depreciation model with one for your specific project</DisplayMessage>
        </Message>
        <Message>
          <Name>DepreciationTooHigh</Name>
          <Expression>DeprecValueCheck &gt; 0</Expression>
          <Severity>Error</Severity>
          <DisplayMessage>Total depreciation value planned exceeds the fixed capital investment of the project. Ensure the sum of DPercent in your depreciation model does not exceed 1.</DisplayMessage>
        </Message>
      </Messages>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="30" Height="55" Canvas.Left="55" Canvas.Top="20" TextAlignment="Center" FontFamily="Arial" FontSize="55" FontStyle="normal" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;€&lt;/TextBlock&gt;
    &lt;TextBlock  Width="30" Height="55" Canvas.Left="15" Canvas.Top="20" TextAlignment="Center" FontFamily="Arial" FontSize="55" FontStyle="normal" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;¥&lt;/TextBlock&gt;
    &lt;TextBlock  Width="100" Height="70" Canvas.Left="0" Canvas.Top="10" TextAlignment="Center" FontFamily="Arial" FontSize="70" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;$&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>HydroRxnOlig1</Type>
      <Description>Default replaceable RxnModelType model for kinetic reactions
which can be used in CSTR, and PFR reactor as well column.
To customize it make a copy in your simulation library.</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Description>DefKinetics fluid type</Description>
          <Type>FluidType</Type>
          <Default>Ibuprofen</Default>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>DefKinetics gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
        </Parameter>
        <Parameter>
          <Name>k01h</Name>
          <Type>Real</Type>
          <Default>0.01125093</Default>
          <Global />
          <Revertible />
        </Parameter>
        <Parameter>
          <Name>k02h</Name>
          <Type>Real</Type>
          <Default>0.00093758</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Ea1h</Name>
          <Type>Real</Type>
          <Default>102000</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Ea2h</Name>
          <Type>Real</Type>
          <Default>105000</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>alfa</Name>
          <Type>Real</Type>
          <Default>4416</Default>
        </Parameter>
        <Parameter>
          <Name>Ccath</Name>
          <Type>Mass Density</Type>
          <Default>0.26</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Type>Integer</Type>
          <Default>3</Default>
        </Parameter>
        <Parameter>
          <Name>K0IBAP</Name>
          <Type>Real</Type>
          <Default>76.4</Default>
        </Parameter>
        <Parameter>
          <Name>K0H2O</Name>
          <Type>Real</Type>
          <Default>529</Default>
        </Parameter>
        <Parameter>
          <Name>K0H</Name>
          <Type>Real</Type>
          <Default>1.39156181</Default>
        </Parameter>
        <Parameter>
          <Name>k03h</Name>
          <Type>Real</Type>
          <Default>0.0023686</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Ea3h</Name>
          <Type>Real</Type>
          <Default>117000</Default>
          <Global />
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>CC</Name>
          <Expression>false</Expression>
        </Condition>
      </Conditions>
      <Variables>
        <Variable>
          <Name>Rate</Name>
          <Description>component reaction rates</Description>
          <Type>Reaction Rate per Volume</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>molar concentrations</Description>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>0.27</Default>
        </Variable>
        <Variable>
          <Name>KIBAP</Name>
          <Type>Real</Type>
          <Default>76.4</Default>
        </Variable>
        <Variable>
          <Name>k</Name>
          <Type>Real</Type>
          <Dimension>Nrxn</Dimension>
          <Default>0.0113</Default>
        </Variable>
        <Variable>
          <Name>KH2O</Name>
          <Type>Real</Type>
          <Default>529</Default>
        </Variable>
        <Variable>
          <Name>KH</Name>
          <Type>Real</Type>
          <Default>1.3916</Default>
        </Variable>
        <Variable>
          <Name>a</Name>
          <Type>Real</Type>
        </Variable>
        <Variable>
          <Name>RateRxn</Name>
          <Type>Reaction Rate per Volume</Type>
          <Dimension>Nrxn</Dimension>
        </Variable>
        <Variable>
          <Name>z</Name>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>1</Default>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Type>Heat Duty</Type>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Cx</Name>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Type>Temperature</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>P</Name>
          <Type>Pressure</Type>
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>k_1</Name>
          <Formula>k[1]=k01h*exp(-Ea1h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>k_2</Name>
          <Formula>k[2]=k02h*exp(-Ea2h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>K_IBAP</Name>
          <Formula>KIBAP=K0IBAP*exp(-Ea1h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>K_H2O</Name>
          <Formula>KH2O=K0H2O*exp(-Ea1h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>K_H</Name>
          <Formula>KH=K0H*exp(-Ea1h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>r_1</Name>
          <Formula>RateRxn[1]=Ccath*a*k[1]*Cx["IBAP"]*P/((1+KIBAP*Cx["IBAP"]+(KH*P)^(1/2)+KH2O*Cx["WATER"])^2)</Formula>
        </Equation>
        <Equation>
          <Name>r_2</Name>
          <Formula>RateRxn[2]=Ccath*a*k[2]*Cx["IBPE"]*P/((1+KIBAP*Cx["IBAP"]+(KH*P)^(1/2)+KH2O*Cx["WATER"])^2)</Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBAB</Name>
          <Formula>Rate["IBAP"]=-RateRxn[1]</Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBPE</Name>
          <Formula>Rate["IBPE"]=RateRxn[1]-RateRxn[2]</Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBEB</Name>
          <Formula>Rate["IBEB"]=RateRxn[2]</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Water</Name>
          <Formula>Rate["WATER"]=RateRxn[2]</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Inerts</Name>
          <Formula>Rate[not{"IBAP","IBPE","IBEB","WATER","OLIG","H2"}]=0</Formula>
        </Equation>
        <Equation>
          <Name>r_3</Name>
          <Formula>RateRxn[3]=Ccath*a*k[3]*Cx["IBAP"]^2/((1+KIBAP*Cx["IBAP"]+(KH*P)^(1/2)+KH2O*Cx["WATER"])^2)</Formula>
        </Equation>
        <Equation>
          <Name>k_3</Name>
          <Formula>k[3]=k03h*exp(-Ea3h/R*(1/T2-1/373))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_olig</Name>
          <Formula>Rate["OLIG"]=RateRxn[3]</Formula>
        </Equation>
        <Equation>
          <Name>a_alfa</Name>
          <Formula>a=exp(-alfa*Cx["OLIG"]/Ccath)</Formula>
        </Equation>
        <Equation>
          <Name>Eqn_Cx</Name>
          <Formula>Cx = StateX.Vl^(-1) * StateX.x</Formula>
        </Equation>
        <Equation>
          <Name>Rate_H2</Name>
          <Formula>Rate["H2"]=-RateRxn[1]-RateRxn[2]+RateRxn[3]</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="60" Height="60" Canvas.Left="30" Canvas.Top="15" FontFamily="Arial" FontSize="58" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;RM&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>CarboRxn</Type>
      <Description>Replaceable RxnModelType model for the CSTR, PFR, and EQR reactor models and Column. Designed for use with CarboRn fluid.</Description>
      <NamePrefix>R</NamePrefix>
      <NameStartingNumber>1</NameStartingNumber>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>FluidType</Name>
          <Type>FluidType</Type>
          <Default>Ibuprofen</Default>
        </Parameter>
        <Parameter>
          <Name>Nrxn</Name>
          <Description>Rates number of individual reactions</Description>
          <Type>Integer</Type>
          <Default>4</Default>
          <Max>100</Max>
          <Min>1</Min>
        </Parameter>
        <Parameter>
          <Name>R</Name>
          <Description>Gas constant</Description>
          <Type>Molar Entropy</Type>
          <Default>8.314</Default>
        </Parameter>
        <Parameter>
          <Name>Ccatc</Name>
          <Type>Molar Concentration</Type>
          <Default>0.0015</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Kc</Name>
          <Type>Real</Type>
          <Default>26.57</Default>
        </Parameter>
        <Parameter>
          <Name>Ea1c</Name>
          <Type>Real</Type>
          <Default>21770</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Ea2c</Name>
          <Type>Real</Type>
          <Default>43620</Default>
          <Global />
          <Invariant />
        </Parameter>
        <Parameter>
          <Name>Ea3c</Name>
          <Type>Real</Type>
          <Default>34720</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Ea4c</Name>
          <Type>Real</Type>
          <Default>33860</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>k01c</Name>
          <Type>Real</Type>
          <Default>6.07</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>k02c</Name>
          <Type>Real</Type>
          <Default>13800</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>k03c</Name>
          <Type>Real</Type>
          <Default>152</Default>
          <Global />
        </Parameter>
        <Parameter>
          <Name>k04c</Name>
          <Type>Real</Type>
          <Default>164000</Default>
          <Global />
        </Parameter>
      </Parameters>
      <Variables>
        <Variable>
          <Name>P</Name>
          <Description>RxnSubmodel pressure</Description>
          <Type>Pressure</Type>
          <UplevelReference />
          <Max>FluidType.PMax</Max>
        </Variable>
        <Variable>
          <Name>T2</Name>
          <Description>RxnSubmodel temperature</Description>
          <Type>Temperature</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>z</Name>
          <Description>RxnSubmodel molar bulk phase composition</Description>
          <Type>Molar Composition</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C</Name>
          <Description>RxnSubmodel molar bulk phase concentration</Description>
          <Type>Molar Concentration</Type>
        </Variable>
        <Variable>
          <Name>RateRxn</Name>
          <Description>RxnSubmodel reaction rate of the individual reactions' base component</Description>
          <Type>Mole Flow</Type>
          <Dimension>Nrxn</Dimension>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>Reaction</Name>
          <Description>RxnSubmodel reaction factor</Description>
          <Type>Fraction</Type>
        </Variable>
        <Variable>
          <Name>Heat</Name>
          <Description>RxnSubmodel heat adjustment (normally zero as enthalpies include heat of formation)</Description>
          <Type>Heat Duty</Type>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Rate</Name>
          <Description>RxnSubmodel component reaction rates</Description>
          <Type>Reaction Rate per Volume</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Min>0</Min>
          <Max>0</Max>
        </Variable>
        <Variable>
          <Name>k</Name>
          <Description>RxnSubmodel rate constant of each reaction</Description>
          <Type>Dimensionless</Type>
          <Dimension>NRxn</Dimension>
        </Variable>
        <Variable>
          <Name>Cx</Name>
          <Description>RxnSubmodel molar concentration of each component in liquid phase</Description>
          <Type>Molar Concentration</Type>
          <Dimension>FluidType.CompList</Dimension>
          <Default>FluidType.Composition</Default>
        </Variable>
        <Variable>
          <Name>C_CO</Name>
          <Type>Molar Concentration</Type>
          <Default>55.5</Default>
        </Variable>
        <Variable>
          <Name>He</Name>
          <Type>Real</Type>
          <Min>-1000000000000</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>Var84</Name>
          <Type>Mass Flow</Type>
          <UplevelReference />
          <Min>-1000000000</Min>
          <Max>1000000000</Max>
        </Variable>
        <Variable>
          <Name>Var86</Name>
          <Type>Mass Flow</Type>
          <UplevelReference />
          <Min>-1000000000</Min>
          <Max>1000000000</Max>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>Eqn_Cx</Name>
          <Formula>Cx = StateX.Vl^(-1) * StateX.x</Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBU</Name>
          <Formula>Rate["IBU"] = (0.95) * RateRxn[4] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBPE</Name>
          <Formula>Rate["IBPE"] = (-1) * RateRxn[1] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBS</Name>
          <Formula>Rate["IBS"] = (1) * RateRxn[1] + (-1) * RateRxn[2] + (1) * RateRxn[3] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_IBPCl</Name>
          <Formula>Rate["IBPCl"] = (1) * RateRxn[2] + (-1) * RateRxn[3] + (-1) * RateRxn[4] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_3-IPPA</Name>
          <Formula>Rate["3-IPPA"] = (0.05) * RateRxn[4] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_Inerts</Name>
          <Description>Inert components not participating in reactions</Description>
          <Formula>Rate[not{"IBU", "IBPE", "IBS", "IBPCl", "3-IPPA","WATER","HCL","CO"}] = 0</Formula>
        </Equation>
        <Equation>
          <Name>k_Rxn1</Name>
          <Formula>k[1] = k01c * exp(-Ea1c / (R * T2))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Rxn1</Name>
          <Formula>RateRxn[1]=k[1]*Cx["IBPE"]</Formula>
        </Equation>
        <Equation>
          <Name>k_Rxn2</Name>
          <Formula>k[2] = k02c * exp(-Ea2c / (R * T2))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Rxn2</Name>
          <Formula>RateRxn[2]=k[2]*Cx["IBS"]*Cx["HCL"]*Cx["HCL"]</Formula>
        </Equation>
        <Equation>
          <Name>k_Rxn3</Name>
          <Formula>k[3] = k03c * exp(-Ea3c / (R * T2))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Rxn3</Name>
          <Formula>RateRxn[3]=k[3]*Cx["IBPCl"]</Formula>
        </Equation>
        <Equation>
          <Name>k_Rxn4</Name>
          <Formula>k[4] = k04c * exp(-Ea4c/ (R * T2))</Formula>
        </Equation>
        <Equation>
          <Name>Rate_Rxn4</Name>
          <Formula>RateRxn[4]=(k[4]*Cx["IBPCl"]*Cx["WATER"]*C_CO*Ccatc^0.43)/(1+Kc*Cx["IBPCl"])</Formula>
        </Equation>
        <Equation>
          <Name>CO</Name>
          <Formula>C_CO=P*He</Formula>
        </Equation>
        <Equation>
          <Name>Rate_H2O</Name>
          <Formula>Rate["WATER"] = (1) * RateRxn[1] + (-1) * RateRxn[4] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_HCL</Name>
          <Formula>Rate["HCL"] = (-1) * RateRxn[2] + (1) * RateRxn[3] + (1) * RateRxn[4] </Formula>
        </Equation>
        <Equation>
          <Name>Rate_CO</Name>
          <Formula>Rate["CO"]=(-1)*RateRxn[4]</Formula>
        </Equation>
        <Equation>
          <Name>Solubility</Name>
          <Formula>He=1.77*10^(-5)*T2-4.4*10^(-3)*Var84/(Var84+Var86)</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>StateX</Name>
          <ModelTypeParameter>FluidType.StateModel</ModelTypeParameter>
        </Model>
      </Models>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
