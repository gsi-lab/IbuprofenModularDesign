    &lt;Path StrokeThickness="2.5" Stroke="#ff000000" StrokeMiterLimit="0.5" Fill="Black" Data="M 0,50 h 40 v -10 l 15,20 l -15,20 v -10 h -40 z"/&gt;
		&lt;!-- Currency symbols --&gt;
    &lt;Ellipse Width="50" Height="50" Canvas.Right="-5" Canvas.Bottom="-5"&gt;
      &lt;Ellipse.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Ellipse.Fill&gt;
    &lt;/Ellipse&gt;
    &lt;TextBlock Width="20" Height="35" Canvas.Right="0" Canvas.Bottom="5" FontFamily="Arial" FontSize="35" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;€&lt;/TextBlock&gt;
    &lt;TextBlock Width="20" Height="35" Canvas.Right="20" Canvas.Bottom="5" FontFamily="Arial" FontSize="35" FontWeight="SemiBold" Foreground="DarkGray" TextWrapping="Wrap"&gt;¥&lt;/TextBlock&gt;
    &lt;TextBlock Width="25" Height="40" Canvas.Right="5" Canvas.Bottom="2.5" FontFamily="Arial" FontSize="40" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;$&lt;/TextBlock&gt;
	&lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
  </Library>
  <FlowSheet>
    <Name>Main</Name>
    <ShowConnectorLabel>false</ShowConnectorLabel>
    <ShowModelLabel>false</ShowModelLabel>
    <Parameters>
      <Parameter>
        <Name>Param1</Name>
        <Type>Real</Type>
      </Parameter>
      <Parameter>
        <Name>Param2</Name>
        <Type>Real</Type>
      </Parameter>
      <Parameter>
        <Name>Param3</Name>
        <Type>Real</Type>
      </Parameter>
    </Parameters>
    <Variables>
      <Variable>
        <Name>Var23</Name>
        <Type>Fraction</Type>
