    <Model>
      <Type>CSTR</Type>
      <Description>Free on board equipment cost estimation for vertical vessel.
To customize it make a copy in your simulation library.</Description>
      <IsConnectionModel />
      <Parameters>
        <Parameter>
          <Name>CurrencyFactor</Name>
          <Description>Global factor to convert default CapEx calculations from USD to local currency units</Description>
          <Type>Ratio</Type>
          <Global />
        </Parameter>
        <Parameter>
          <Name>Mm</Name>
          <Type>Metal Mass</Type>
        </Parameter>
      </Parameters>
      <Variables>
        <Variable>
          <Name>FM</Name>
          <Description>VertDrum material correction factor</Description>
          <Type>Ratio</Type>
        </Variable>
        <Variable>
          <Name>CV</Name>
          <Description>VertDrum base cost of the vessel</Description>
          <Type>Currency</Type>
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>CB</Name>
          <Description>VertDrum free on board purchase cost of vertical vessel</Description>
          <Type>Currency</Type>
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>D</Name>
          <Description>VertDrum diameter of the vessel</Description>
          <Type>Diameter</Type>
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>VertDrum length of the vessel</Description>
          <Type>Length</Type>
        </Variable>
        <Variable>
          <Name>CPL</Name>
          <Description>VertDrum base cost of the platform and ladders</Description>
          <Type>Currency</Type>
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>CostB</Name>
          <Description>Free on board purchase cost of vertical vessel. CurrencyFactor parameter converts base cost form USD to OpEx currency.</Description>
          <Formula>CB =  (FM * CV + CPL) * CurrencyFactor</Formula>
        </Equation>
        <Equation>
          <Name>CostB1</Name>
          <Description>Base equipment cost for vertical vessel.\n 2.20462 is the conversion factor for kg to lb.</Description>
          <Formula>CV = exp(7.1390 + 0.18255 * ln(Mm * 2.20462)+ 0.02297 * ln(Mm * 2.20462)^2)</Formula>
        </Equation>
        <Equation>
          <Name>CostB2</Name>
          <Description>Base equipment cost for platform and ladder.\n 3.28084 is the conversion factor for m to ft.</Description>
          <Formula>CPL = 410 * (D * 3.28084)^0.7396 * (L * 3.28084)^0.70684</Formula>
        </Equation>
      </Equations>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Fill"&gt;
  &lt;Canvas Width="100" Height="100"&gt;
    &lt;Path StrokeThickness="5" Stroke="Black" Data="M 50,3 a 47,47 0 0 0 0,94 a 47,47 0 0 0 0,-94"&gt;
      &lt;Path.Fill&gt;
        &lt;RadialGradientBrush  GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="1" RadiusY="1" &gt;
          &lt;GradientStop Color="White" Offset="0.0" /&gt;
          &lt;GradientStop Color="#ff707070" Offset="1.0" /&gt;
        &lt;/RadialGradientBrush&gt;
      &lt;/Path.Fill&gt;
    &lt;/Path&gt;
    &lt;TextBlock  Width="60" Height="60" Canvas.Left="25" Canvas.Top="13" FontFamily="Arial" FontSize="58" FontStyle="normal" FontWeight="SemiBold" Foreground="Black" TextWrapping="Wrap"&gt;M&lt;/TextBlock&gt;
  &lt;/Canvas&gt;
&lt;/Viewbox&gt;</Drawing>
              </Rendering>
            </Image>
          </Images>
        </Icon>
      </GraphicData>
      <Help>
        <Content format="rtfzip"><![CDATA[]]></Content>
      </Help>
    </Model>
    <Model>
      <Type>CapExCSTR</Type>
      <Description>Free on board equipment cost estimation for Vessels such as Drum and Separator models.
This submodel extends other models. While holding SHIFT, drag it on top of an existing model in your simulation.
To customize it make a copy in your simulation library.</Description>
      <NamePrefix>CapEx</NamePrefix>
      <IsReplaceableModel />
      <Parameters>
        <Parameter>
          <Name>CEPCI</Name>
          <Description>Global Chemical Engineering Plant Cost Index</Description>
          <Type>Dimensionless</Type>
          <Group>Economics</Group>
          <Default>596.2</Default>
          <Favorite />
          <Global />
        </Parameter>
        <Parameter>
          <Name>CurrencyFactor</Name>
          <Description>Global factor to convert default CapEx calculations from USD to local currency units</Description>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <Favorite />
          <Global />
        </Parameter>
        <Parameter>
          <Name>MOC</Name>
          <Description>CapExVessel material of construction</Description>
          <Type>Enumeration</Type>
          <Group>Economics</Group>
          <Default>Carbon Steel</Default>
          <Required />
          <Favorite />
          <Values>
            <Value>Carbon Steel</Value>
            <Value>Low-alloy Steel</Value>
            <Value>Stainless Steel 304</Value>
            <Value>Stainless Steel 316</Value>
            <Value>Carpenter 20CB-3</Value>
            <Value>Nickel-200</Value>
            <Value>Monel-400</Value>
            <Value>Iconel-600</Value>
            <Value>Icoloy-825</Value>
            <Value>Titanium</Value>
            <Value>Other</Value>
          </Values>
        </Parameter>
        <Parameter>
          <Name>MM</Name>
          <Type>Metal Mass</Type>
          <UplevelReference />
        </Parameter>
      </Parameters>
      <Conditions>
        <Condition>
          <Name>Pro</Name>
          <Expression>Mode = Process</Expression>
        </Condition>
        <Condition>
          <Name>MOC1</Name>
          <Expression>Pro and MOC = "Carbon Steel"</Expression>
        </Condition>
        <Condition>
          <Name>MOC2</Name>
          <Expression>Pro and MOC = "Low-Alloy Steel"</Expression>
        </Condition>
        <Condition>
          <Name>MOC3</Name>
          <Expression>Pro and MOC = "Stainless Steel 304"</Expression>
        </Condition>
        <Condition>
          <Name>MOC4</Name>
          <Expression>Pro and MOC = "Stainless Steel 316"</Expression>
        </Condition>
        <Condition>
          <Name>MOC5</Name>
          <Expression>Pro and MOC = "Carpenter 20CB-3"</Expression>
        </Condition>
        <Condition>
          <Name>MOC6</Name>
          <Expression>Pro and MOC = "Nickel-200"</Expression>
        </Condition>
        <Condition>
          <Name>MOC7</Name>
          <Expression>Pro and MOC = "Monel-400"</Expression>
        </Condition>
        <Condition>
          <Name>MOC8</Name>
          <Expression>Pro and MOC = "Iconel-600"</Expression>
        </Condition>
        <Condition>
          <Name>MOC9</Name>
          <Expression>Pro and MOC = "Icoloy-825"</Expression>
        </Condition>
        <Condition>
          <Name>MOC10</Name>
          <Expression>Pro and MOC = "Titanium"</Expression>
        </Condition>
        <Condition>
          <Name>MOC11</Name>
          <Expression>(Pro and MOC = "Other") or (not Pro)</Expression>
        </Condition>
        <Condition>
          <Name>MOC12</Name>
          <Expression>Pro and MOC &lt;&gt; "Other"</Expression>
        </Condition>
        <Condition>
          <Name>C</Name>
          <Expression>false</Expression>
        </Condition>
      </Conditions>
      <Connections>
        <Connection>
          <Name>Conn3</Name>
          <Condition>Pro</Condition>
          <Type>Variable</Type>
          <From>D</From>
          <To>CSTR.D</To>
        </Connection>
        <Connection>
          <Name>Conn4</Name>
          <Type>Parameter</Type>
          <From>MM</From>
          <To>CSTR.MM</To>
        </Connection>
        <Connection>
          <Name>Conn5</Name>
          <Type>Variable</Type>
          <From>FM</From>
          <To>CSTR.FM</To>
        </Connection>
      </Connections>
      <Variables>
        <Variable>
          <Name>D</Name>
          <Description>CapExVessel diameter of the cylinder</Description>
          <Condition>Pro</Condition>
          <Type>Diameter</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>L</Name>
          <Description>CapExVessel length of the cylinder</Description>
          <Condition>Pro</Condition>
          <Type>Length</Type>
          <UplevelReference />
        </Variable>
        <Variable>
          <Name>FM</Name>
          <Description>CapExVessel material correction factor. Typical values: \n     1.0: Carbon Steel\n     1.2: Low-alloy Steel\n     1.7: Stainless Steel 304\n     2.1: Stainless Steel 304\n     3.2: Carpenter 20CB-3\n     5.4: Nickel-200\n     3.6: Monel-400\n     3.9: Iconel-600\n     3.7: Icoloy-825\n     7.7: Titanium</Description>
          <Condition>MOC12</Condition>
          <Type>Ratio</Type>
        </Variable>
        <Variable>
          <Name>FM</Name>
          <Description>CapExVessel material correction factor. Typical values: \n     1.0: Carbon Steel\n     1.2: Low-alloy Steel\n     1.7: Stainless Steel 304\n     2.1: Stainless Steel 304\n     3.2: Carpenter 20CB-3\n     5.4: Nickel-200\n     3.6: Monel-400\n     3.9: Iconel-600\n     3.7: Icoloy-825\n     7.7: Titanium</Description>
          <Condition>MOC11</Condition>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Required />
          <Favorite />
        </Variable>
        <Variable>
          <Name>FCP</Name>
          <Description>CapExVessel known cost scale factor to adjust pricing to a known cost from another source</Description>
          <Type>Ratio</Type>
          <Group>Economics</Group>
          <ProcessMode />
          <FluidFlowMode />
          <DynamicMode />
          <Favorite />
        </Variable>
        <Variable>
          <Name>CP</Name>
          <Description>CapExVessel free on board purchase cost of vessel including platform and ladders</Description>
          <Type>Currency</Type>
          <Group>Economics</Group>
          <FluidFlowMode Lock="Always">true</FluidFlowMode>
          <DynamicMode Lock="Always">true</DynamicMode>
          <Favorite />
          <TotalizedVariable />
          <Min>0</Min>
          <Max>1000000000000</Max>
        </Variable>
        <Variable>
          <Name>UncertaintyVessel</Name>
          <Type>Real</Type>
          <Global />
          <UplevelReference />
        </Variable>
      </Variables>
      <Equations>
        <Equation>
          <Name>CostP</Name>
          <Description>Free on board purchase cost of vessel</Description>
          <Formula>CP = CSTR.CB * (CEPCI / 567) * FCP*UncertaintyVessel</Formula>
        </Equation>
        <Equation>
          <Name>Len</Name>
          <Formula>CSTR.L = L</Formula>
        </Equation>
        <Equation>
          <Name>FM1</Name>
          <Condition>MOC1</Condition>
          <Formula>FM = 1</Formula>
        </Equation>
        <Equation>
          <Name>FM2</Name>
          <Condition>MOC2</Condition>
          <Formula>FM = 1.2</Formula>
        </Equation>
        <Equation>
          <Name>FM3</Name>
          <Condition>MOC3</Condition>
          <Formula>FM = 1.7</Formula>
        </Equation>
        <Equation>
          <Name>FM4</Name>
          <Condition>MOC4</Condition>
          <Formula>FM = 2.1 </Formula>
        </Equation>
        <Equation>
          <Name>FM5</Name>
          <Condition>MOC5</Condition>
          <Formula>FM = 3.2</Formula>
        </Equation>
        <Equation>
          <Name>FM6</Name>
          <Condition>MOC6</Condition>
          <Formula>FM = 5.4</Formula>
        </Equation>
        <Equation>
          <Name>FM7</Name>
          <Condition>MOC7</Condition>
          <Formula>FM = 3.6</Formula>
        </Equation>
        <Equation>
          <Name>FM8</Name>
          <Condition>MOC8</Condition>
          <Formula>FM = 3.9</Formula>
        </Equation>
        <Equation>
          <Name>FM9</Name>
          <Condition>MOC9</Condition>
          <Formula>FM = 3.7</Formula>
        </Equation>
        <Equation>
          <Name>FM10</Name>
          <Condition>MOC10</Condition>
          <Formula>FM = 7.7</Formula>
        </Equation>
      </Equations>
      <Models>
        <Model>
          <Name>CSTR</Name>
          <Type>CSTR</Type>
        </Model>
      </Models>
      <Groups>
        <Group>
          <Name>Economics</Name>
          <Description>Operating expense and capital cost estimation</Description>
        </Group>
      </Groups>
      <GraphicData>
        <Icon>
          <DefaultIcon>Default</DefaultIcon>
          <Images>
            <Image>
              <Name>Default</Name>
              <Rendering>
                <Drawing Format="xaml">&lt;Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform"&gt;
